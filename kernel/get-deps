#! /bin/sh

# Fetches the two small, permissively-licensed headers this kernel needs
# that are not (and should not be) vendored in the repository:
#
#   include/limine.h          the Limine boot protocol header (BSD-2-Clause)
#   include/font8x8_basic.h   an 8x8 bitmap font for the console (Public Domain)
#
# Re-run this (or just `rm kernel/.deps-obtained && make`) to refresh
# limine.h against a newer protocol revision.

set -ex

# Always operate relative to this script's own directory (kernel/),
# regardless of where `make` was invoked from.
cd "$(dirname "$0")"

mkdir -p include

curl -Lo include/limine.h \
    https://raw.githubusercontent.com/Limine-Bootloader/limine-protocol/trunk/include/limine.h

curl -Lo include/font8x8_basic.h \
    https://raw.githubusercontent.com/dhepper/font8x8/master/font8x8_basic.h

# Marker so the top-level GNUmakefile doesn't re-fetch on every build.
# Delete this file (or just `make distclean`) to force a re-fetch.
touch .deps-obtained
